# e-Arzuhal GraphRAG Server Environment Variables
# Kopyala -> .env olarak kaydet ve değerleri doldur
# UYARI: .env dosyasını asla git'e commit etme!

# ── Sunucu ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ── Neo4j ─────────────────────────────────────────────────────────────────────
# Docker ile çalışıyorsan: bolt://neo4j:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# openssl rand -hex 16 ile üret
NEO4J_PASSWORD=changeme

# ── Gemini ────────────────────────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey adresinden al
# Boş bırakılırsa LLM analizi devre dışı kalır, gap analizi çalışmaya devam eder
GEMINI_API_KEY=

# ── Güvenlik ──────────────────────────────────────────────────────────────────
# İzin verilen origin'ler (virgülle ayrılmış) — yalnızca main-server erişmeli
ALLOWED_ORIGINS=http://localhost:8080
# Dahili servis API anahtarı — main-server'daki INTERNAL_API_KEY ile aynı olmalı
# openssl rand -hex 32 ile üret
INTERNAL_API_KEY=

# ── Loglama ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
