# e-Arzuhal GraphRAG Server Environment Configuration
# Copy this file to .env and update the values

# Neo4j Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j_user_name_here
NEO4J_PASSWORD=your_password_here

# Application Configuration
APP_NAME=e-Arzuhal GraphRAG API
APP_VERSION=1.0.0
DEBUG=false

INTERNAL_API_KEY=

# Birincil Gemini API anahtarı (zorunlu)
GEMINI_API_KEY=

# Yedek Gemini API anahtarı (opsiyonel) — birincil 503/quota döner ya da
# kalitesiz yanıt verirse otomatik olarak bu anahtar denenir.
GEMINI_API_KEY_FALLBACK=